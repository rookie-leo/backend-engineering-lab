{
  "request": {
    "method": "POST",
    "urlPath": "/api/payment-provider/ACC-0003",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "equalToJson": {
          "amount": 1500.00,
          "currency": "BRL"
        },
        "ignoreArrayOrder": true,
        "ignoreExtraElements": true
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName":  "payment-slow-response-response.json",
    "fixedDelayMilliseconds": 10000
  }
}